# AfiliaFacil - variáveis de ambiente
# Copie este arquivo para .env (gitignorado) e preencha suas credenciais.
# NUNCA commitar chaves reais no git — o GitHub blocking detection impede o push.

# PIX (gateway estático com aprovação manual)
PIX_KEY=
PIX_NAME=AfiliaFacil
PIX_CITY=SAO PAULO

# Stripe (checkout automático via webhook)
# Endpoint do webhook para configurar no painel Stripe:
#   https://SEU-DOMINIO/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
# Chaves de teste: sk_test_... / whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gateway ativo: pix | stripe
CHECKOUT_DRIVER=pix

# Banco de dados (opcional - sem configuracao usa fallback JSON em data/)
# Postgres (default) ou MySQL: DB_CONNECTION=mysql
# Runtime: role restrita (sem DDL) - criada automaticamente pelo bin/migrate.php
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=afiliafacil
DB_USERNAME=afiliafacil_app
DB_PASSWORD=
# Migracoes: usuario owner (DDL)
DB_MIGRATION_USER=afiliafacil
DB_MIGRATION_PASSWORD=
# Role restrita criada/atualizada no boot
DB_APP_USER=afiliafacil_app
DB_APP_PASSWORD=
# Container Postgres (docker-compose)
POSTGRES_DB=afiliafacil
POSTGRES_USER=afiliafacil
POSTGRES_PASSWORD=
# Alternativa: DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Chave para criptografia de credenciais (R2 etc)
APP_KEY=

# Espionagem de Anuncios
# Cloudflare Workers AI (IA padrao da plataforma - 10k neurons/dia gratis)
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_AI_MODEL=@cf/nvidia/nemotron-3-120b-a12b
# Modelo de transcricao (STT) padrao da plataforma
CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
# Modelo de narracao (TTS) padrao da plataforma
CF_TTS_MODEL=@cf/myshell-ai/melotts
# Busca de anuncios (SERPAPI_KEY/META_AD_ACCESS_TOKEN da PLATAFORMA)
# ATENCAO: estas chaves sao usadas SOMENTE pelo sistema/cron (coleta de ofertas).
# As buscas dos usuarios usam a chave PROPRIA configurada no painel (IA > Busca de Anuncios).
# Usuario sem chave propria: o provedor fica indisponivel (nao gastamos a chave da plataforma).
# SerpApi (Google Ads Transparency - free: 250 buscas/mes)
SERPAPI_KEY=
# Meta Ad Library API oficial (opcional - cobre anuncios politicos + UE)
META_AD_ACCESS_TOKEN=
# SearXNG self-hosted (pesquisa web do Socio - sem limite de chave)
# Ex.: instancia do docker-compose (http://searxng:8080) ou Pinokio no host (http://host.docker.internal:52301)
SEARXNG_URL=

# Chave alternativa da plataforma (opcional) - usada quando a principal estoura a cota diaria
# (ex.: segunda conta Cloudflare gratuita soma +10k neurons/dia para o admin)
CF_ACCOUNT_ID_2=
CF_AI_TOKEN_2=
# Chave dedicada do ADMIN (plano premium) - o admin nao depende da cota compartilhada dos clientes
CF_ACCOUNT_ID_ADMIN=
CF_AI_TOKEN_ADMIN=
# Chave dedicada do TRIAL (opcional) - isola o consumo do trial
CF_ACCOUNT_ID_TRIAL=
CF_AI_TOKEN_TRIAL=

# CRON (Ofertas Escalando - Plano B)
# Gere com: openssl rand -hex 32
# Endpoint: https://SEU-DOMINIO/cron/monitor.php?key=SEU_CRON_KEY
# Modo de monitoramento configuravel em Admin > Ofertas (cron | manual)
CRON_KEY=
