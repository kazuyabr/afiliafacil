# AfiliaFacil - variáveis de ambiente (copie para .env ou configure no docker-compose)
# As chaves Stripe são de TESTE por padrão; substitua pelas de produção quando validar.

# PIX (gateway estático com aprovação manual)
PIX_KEY=
PIX_NAME=AfiliaFacil
PIX_CITY=SAO PAULO

# Stripe (checkout automático via webhook)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXX

# Gateway ativo: pix | stripe
CHECKOUT_DRIVER=pix
